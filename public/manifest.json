{
  "manifest_version": 3,
  "name": "repo2txt",
  "version": "1.0.0",
  "description": "Browser extension to convert repositories to LLM-ready text",
  "homepage_url": "https://github.com/michael-farah/repo2txt-extension",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Open repo2txt",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": ["storage", "clipboardWrite", "activeTab", "scripting", "downloads", "tabs"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
"content_scripts": [
  {
"matches": [
"https://github.com/*/*",
"https://github.com/*/*/commit/*",
"https://github.com/*/*/pull/*",
"https://github.com/*/*/compare/*"
],
"exclude_matches": [
"https://github.com/*/*/issues/*",
"https://github.com/*/*/wiki/*",
"https://github.com/*/*/actions/*",
"https://github.com/*/*/projects/*",
"https://github.com/*/*/security/*",
"https://github.com/*/*/pulse/*",
"https://github.com/*/*/settings/*"
],
"js": ["content-scripts/github.js"]
}
  ],
  "content_security_policy": {
  "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
